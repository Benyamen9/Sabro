<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sabro.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 4 runs on Microsoft.Testing.Platform, which no longer supports
         the VSTest target on the .NET 10 SDK. Without this opt-in `dotnet test`
         refuses to run at all. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Plain reference, unlike the coverlet collector it replaces. The MTP
         extension self-registers through generated code, so it needs its
         compile assets; the trimmed IncludeAssets list used for analyzers
         and collectors makes that generated file fail to compile. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sabro.Shared\Sabro.Shared.csproj" />
    <ProjectReference Include="..\..\src\Sabro.Shared.Infrastructure\Sabro.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.Lexicon\Sabro.Lexicon.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.Play\Sabro.Play.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.Translations\Sabro.Translations.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.Reviews\Sabro.Reviews.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.Biblical\Sabro.Biblical.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.BethGazo\Sabro.BethGazo.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.Historical\Sabro.Historical.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sabro.Identity\Sabro.Identity.csproj" />
  </ItemGroup>

</Project>
